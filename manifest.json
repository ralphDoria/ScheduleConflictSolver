{
  "name": "Hello Extensions of the World!",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/hello_extension_icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://my.ucdavis.edu/schedulebuilder/index.cfm?termCode=*"],
      "js": ["scripts/getPidm.js", "scripts/search.js", "scripts/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["html-files/main-panel.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["scripting"],
  "host_permissions": ["<url of the schedule builder>"]
}