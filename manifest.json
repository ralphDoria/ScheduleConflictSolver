{
  "name": "ScheduleBob",
  "description": "An automatic schedule builder & course conflict solver for UC Davis's ScheduleBuilder",
  "version": "2.0",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "16": "images/ScheduleBobLogoZoomed.png",
    "48": "images/ScheduleBobLogoZoomed.png",
    "128": "images/ScheduleBobLogoZoomed.png"
  },
  "permissions": ["identity", "storage"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "images/ScheduleBobLogoZoomed.png"
  },
  "content_scripts": [
    {
      "matches": ["https://my.ucdavis.edu/schedulebuilder/index.cfm?termCode=*"],
      "js": [
        "scripts/getTermCode.js",
        "scripts/getPidm.js",
        "scripts/search.js",
        "scripts/parseData.js",
        "scripts/parseCustomTimeBlocks.js",
        "scripts/createAllPossibleSchedules.js",
        "scripts/pageBridge.js",
        "scripts/scheduleAPI.js",
        "scripts/weekCalendar.js",
        "scripts/friendsModal.js",
        "scripts/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["html-files/main-panel.html", "images/*", "scripts/bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://my.ucdavis.edu/schedulebuilder",
    "https://qfbfwukccesajdrsjako.supabase.co/*"
  ]
}